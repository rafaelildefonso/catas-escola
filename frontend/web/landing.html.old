<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CATAS – Automatize Qualquer Processo com IA e Linguagem Natural</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@latest"></script>
<style>
  :root {
    --background: #09090B;
    --surface: #18181B;
    --surface-highlight: #27272A;
    --border: #3F3F46;
    --primary: #3B82F6;
    --primary-foreground: #ffffff;
    --text-primary: #F4F4F5;
    --text-secondary: #A1A1AA;
    --error: #ef4444;
    --success: #22c55e;
    --white: #ffffff;
    --card-green-bg: rgba(34, 197, 94, 0.05);
    --card-green-border: rgba(34, 197, 94, 0.2);
    --card-red-bg: rgba(239, 68, 68, 0.05);
    --card-red-border: rgba(239, 68, 68, 0.2);
  }

  [data-theme="light"] {
    --background: #FAFAFA;
    --surface: #FFFFFF;
    --surface-highlight: #F4F4F5;
    --border: #E4E4E7;
    --primary: #2563EB;
    --primary-foreground: #ffffff;
    --text-primary: #09090B;
    --text-secondary: #52525B;
    --error: #dc2626;
    --success: #16a34a;
    --card-green-bg: rgba(22, 163, 74, 0.05);
    --card-green-border: rgba(22, 163, 74, 0.2);
    --card-red-bg: rgba(220, 38, 38, 0.05);
    --card-red-border: rgba(220, 38, 38, 0.2);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease; }

  body {
    background: var(--background);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
  }

  .theme-toggle {
    position: fixed;
    bottom: 32px;
    right: 32px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    z-index: 9999;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .theme-toggle:hover { transform: scale(1.1) translateY(-2px); border-color: var(--primary); box-shadow: 0 15px 30px rgba(59, 130, 246, 0.2); }
  .theme-toggle i { width: 24px; height: 24px; }
  .sun-icon { display: block; }
  .moon-icon { display: none; }
  [data-theme="light"] .sun-icon { display: none; }
  [data-theme="light"] .moon-icon { display: block; }

  /* ── HERO ── */
  .hero {
    background: var(--background);
    padding: 60px 5% 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 60px;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }

  .hero-left { max-width: 560px; flex: 1; }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .logo-icon {
    width: 48px; height: 48px;
    background: var(--primary);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 900; font-size: 20px; color: var(--primary-foreground);
  }

  .logo-text { font-size: 14px; font-weight: 600; text-transform: uppercase; line-height: 1.2; letter-spacing: 0.5px; }
  .logo-text span { color: var(--primary); }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .hero h1 .highlight { color: var(--primary); }

  .hero p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }

  .btn-primary {
    display: inline-block;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 700;
    font-size: 1.1rem;
    padding: 20px 40px;
    border: none;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s ease;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
  }
  .btn-primary:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }

  .btn-outline-cyan {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--border);
    color: var(--text-primary);
    padding: 12px 20px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-weight: 500;
    background: var(--surface);
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-outline-cyan:hover { border-color: var(--primary); background: var(--surface-highlight); }

  .pills {
    display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px;
  }

  .hero-right {
    flex: 1; max-width: 480px;
    position: relative;
  }

  .hero-photo-wrapper {
    position: relative;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .fake-window-bar {
    background: var(--surface-highlight);
    padding: 10px 16px;
    display: flex; gap: 8px; align-items: center;
    border-bottom: 1px solid var(--border);
  }

  .win-btn {
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--border);
  }

  .hero-photo {
    width: 100%;
    display: block;
    aspect-ratio: 4/3;
    object-fit: cover;
  }

  .hero-photo-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, #18181B, #27272A);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
  }

  .discount-badge {
    position: absolute;
    bottom: -24px; right: -24px;
    background: var(--primary);
    color: var(--primary-foreground);
    padding: 20px 24px;
    border-radius: 16px;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3);
  }

  .discount-badge .label { font-size: 0.9rem; font-weight: 500; opacity: 0.9; }
  .discount-badge .value { font-size: 2.8rem; font-weight: 800; line-height: 1; }
  .discount-badge .off { font-size: 1.1rem; font-weight: 600; }

  /* ── SECTION BASE ── */
  section { padding: 100px 5%; }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    text-align: center;
    line-height: 1.2;
    margin-bottom: 60px;
    letter-spacing: -0.02em;
  }

  .section-title .accent { color: var(--primary); }
  .section-title .accent-cyan { color: var(--primary); }

  /* ── PROFESSORS ── */
  .professors { background: var(--background); }

  .prof-carousel { position: relative; overflow: hidden; }
  .prof-track {
    display: flex;
    transition: transform 0.4s ease;
  }

  .prof-slide {
    min-width: 33.333%;
    padding: 0 12px;
  }

  .prof-card {
    background: var(--surface);
    color: var(--text-primary);
    text-align: center;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    height: 100%;
    transition: transform 0.3s ease;
  }
  .prof-card:hover { transform: translateY(-5px); border-color: var(--primary); }

  .prof-card img, .prof-card .prof-img-placeholder {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .prof-img-placeholder {
    background: var(--surface-highlight);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: var(--primary);
  }

  .prof-card-body { padding: 32px 24px; }
  .prof-name {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }
  .prof-bio { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; }

  .carousel-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }

  .carousel-btn {
    width: 48px; height: 48px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    cursor: pointer;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s;
  }
  .carousel-btn:hover { background: var(--primary); color: var(--primary-foreground); border-color: var(--primary); }

  .carousel-dots { display: flex; gap: 10px; }
  .dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
    transition: all 0.2s;
  }
  .dot.active { background: var(--primary); width: 24px; border-radius: 5px; }

  /* ── WHO CAN ── */
  .who-can { background: var(--background); }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .who-left h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .who-left p { color: var(--text-secondary); margin-bottom: 20px; font-size: 1.1rem; }
  .who-left strong { color: var(--text-primary); font-weight: 600; }

  .card-green {
    background: var(--card-green-bg);
    border: 1px solid var(--card-green-border);
    padding: 32px;
    margin-bottom: 20px;
    border-radius: 12px;
  }

  .card-green h3 {
    color: var(--success);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .card-red {
    background: var(--card-red-bg);
    border: 1px solid var(--card-red-border);
    padding: 32px;
    margin-bottom: 20px;
    border-radius: 12px;
  }

  .card-red h3 {
    color: var(--error);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 16px;
    display: flex; align-items: center; gap: 10px;
  }

  .card-red ul, .card-green ul {
    list-style: none;
    padding: 0;
  }

  .card-red li, .card-green li {
    padding: 8px 0;
    padding-left: 28px;
    position: relative;
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .card-green li::before { content: ""; position: absolute; left: 0; top: 12px; width: 16px; height: 16px; background: var(--success); -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>') no-repeat center; mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>') no-repeat center; }
  .card-red li::before { content: ""; position: absolute; left: 0; top: 12px; width: 16px; height: 16px; background: var(--error); -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>') no-repeat center; mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>') no-repeat center; }

  /* ── TESTIMONIALS ── */
  .testimonials { background: var(--background); text-align: center; }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 60px;
  }

  .video-thumb {
    position: relative;
    aspect-ratio: 16/9;
    background: var(--surface);
    cursor: pointer;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  .video-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .video-thumb .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.4);
    transition: background 0.3s;
  }
  .video-thumb:hover .play-overlay { background: rgba(0,0,0,0.2); }

  .play-btn {
    width: 72px; height: 72px;
    background: var(--primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: white;
    transition: transform 0.3s;
    box-shadow: 0 10px 20px rgba(59, 130, 246, 0.4);
  }
  .video-thumb:hover .play-btn { transform: scale(1.1); }

  .btn-outline-green {
    display: inline-block;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 700;
    font-size: 1.1rem;
    padding: 20px 48px;
    cursor: pointer;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s;
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
  }
  .btn-outline-green:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6); }

  /* ── CURRICULUM ── */
  .curriculum { background: var(--background); }

  .curr-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .curr-left {
    display: flex; align-items: center; justify-content: center;
  }

  .laptop-mock {
    background: var(--surface);
    border-radius: 20px;
    padding: 24px;
    border: 1px solid var(--border);
    text-align: center;
    font-size: 6rem;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
  }

  .module-list { list-style: none; padding: 0; }
  .module-item {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 18px 24px;
    margin-bottom: 12px;
    border-radius: 12px;
    font-size: 1rem;
    cursor: default;
    transition: all 0.2s;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .module-item:hover { background: var(--surface-highlight); border-color: var(--primary); color: var(--text-primary); }

  /* ── ERRORS ── */
  .errors { background: linear-gradient(180deg, var(--background) 0%, var(--surface) 100%); }

  .errors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 80px;
  }

  .error-card {
    border: 1px solid var(--border);
    padding: 40px 32px;
    border-radius: 16px;
    background: var(--surface);
    transition: border-color 0.3s;
  }
  .error-card:hover { border-color: var(--error); }

  .error-number {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--error);
    margin-bottom: 16px;
    letter-spacing: 0.05em;
  }

  .error-card h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 16px;
    line-height: 1.3;
  }

  .error-card p { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.7; }

  .what-market {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 80px;
    align-items: center;
    margin-top: 80px;
    background: var(--surface);
    padding: 60px;
    border-radius: 24px;
    border: 1px solid var(--border);
  }

  .what-market h2 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 32px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .check-card {
    border: 1px solid var(--border);
    padding: 24px;
    background: var(--surface-highlight);
    border-radius: 12px;
    margin-bottom: 16px;
    display: flex;
    gap: 16px;
    transition: transform 0.2s;
  }
  .check-card:hover { transform: translateX(10px); border-color: var(--primary); }

  .check-icon { color: var(--success); font-size: 1.4rem; margin-top: 2px; }

  .market-graphic {
    display: flex; align-items: center; justify-content: center;
    font-size: 8rem;
    color: var(--primary);
    opacity: 0.8;
  }

  /* ── PRESS ── */
  .press { background: var(--background); }

  .press-clips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .press-clip {
    border: 1px solid var(--border);
    padding: 32px;
    background: var(--surface);
    border-radius: 16px;
    transition: transform 0.2s;
  }
  .press-clip:hover { transform: translateY(-5px); border-color: var(--primary); }

  .press-clip .source { font-size: 0.85rem; font-weight: 700; color: var(--primary); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.05em; }
  .press-clip h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 12px; line-height: 1.4; color: var(--text-primary); }
  .press-clip p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }

  /* ── ANHANGUERA (REFINED AS "SECURITY & TRUST") ── */
  .anhanguera { background: var(--surface); }

  .anh-header {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    text-align: center;
    margin-bottom: 60px;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .anh-header .accent { color: var(--primary); }

  .anh-card {
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto 60px;
    background: var(--background);
  }

  .anh-logo {
    text-align: center;
    font-size: 6rem;
    color: var(--primary);
  }

  .anh-info h3 { font-size: 1.6rem; font-weight: 700; margin-bottom: 16px; color: var(--text-primary); }
  .anh-info p { font-size: 1rem; color: var(--text-secondary); margin-bottom: 16px; line-height: 1.7; }

  .anh-stats {
    display: flex;
    gap: 40px;
    margin-top: 32px;
  }

  .anh-stat h4 { font-size: 1.8rem; font-weight: 800; color: var(--primary); margin-bottom: 4px; }
  .anh-stat p { font-size: 0.85rem; color: var(--text-secondary); font-weight: 500; }

  .anh-cta { text-align: center; }

  /* ── FAQ ── */
  .faq { background: var(--background); }

  .faq-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 40px;
    text-align: center;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
    letter-spacing: -0.02em;
  }

  .faq-list { max-width: 800px; margin: 0 auto 40px; }

  .faq-item {
    border: 1px solid var(--border);
    margin-bottom: 12px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.2s;
  }
  .faq-item:hover { border-color: var(--primary); }

  .faq-question {
    padding: 24px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.1rem;
    font-weight: 600;
    background: var(--surface);
    transition: background 0.2s;
    color: var(--text-primary);
  }
  .faq-question:hover { background: var(--surface-highlight); }
  .faq-question .plus { font-size: 1.5rem; color: var(--primary); transition: transform 0.3s; }
  .faq-item.open .faq-question .plus { transform: rotate(45deg); }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    background: var(--background);
    font-size: 1rem;
    color: var(--text-secondary);
    padding: 0 24px;
    line-height: 1.7;
  }

  .faq-item.open .faq-answer {
    max-height: 500px;
    padding: 20px 24px 32px;
  }

  .faq-cta { text-align: center; }

  /* ── FOOTER ── */
  footer {
    background: var(--background);
    padding: 60px 5%;
    text-align: center;
    border-top: 1px solid var(--border);
  }

  footer .footer-logo { font-size: 2.5rem; margin-bottom: 16px; color: var(--primary); }
  footer p { font-size: 0.95rem; color: var(--text-secondary); margin-bottom: 8px; }
  footer strong { color: var(--text-primary); }

  footer .disclaimer {
    font-size: 0.8rem;
    color: var(--text-secondary);
    max-width: 800px;
    margin: 32px auto 0;
    line-height: 1.6;
    opacity: 0.6;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero { flex-direction: column; padding: 40px 4% 60px; min-height: auto; }
    .hero-right { max-width: 100%; }
    .who-grid, .curr-grid, .what-market, .anh-card { grid-template-columns: 1fr; }
    .errors-grid, .press-clips, .video-grid { grid-template-columns: 1fr; }
    .prof-slide { min-width: 100%; }
  }

  @media (max-width: 600px) {
    section { padding: 50px 4%; }
    .pills { flex-direction: column; }
  }

  /* scroll reveal */
  .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.visible { opacity: 1; transform: none; }
</style>
<script>
  // Pre-load theme to avoid flash
  const savedTheme = localStorage.getItem('theme') || 'dark';
  if (savedTheme === 'light') {
    document.documentElement.setAttribute('data-theme', 'light');
  }
</script>
</head>
