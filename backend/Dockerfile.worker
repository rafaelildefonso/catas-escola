FROM python:3.11-slim

WORKDIR /app

# System dependencies for cryptography, etc.
RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy all server source code
COPY . .

# Set Python path to include worker directory
ENV PYTHONPATH=/app/worker:/app

# Run the worker entrypoint (valida módulos e mantém container vivo)
CMD ["python", "worker/entrypoint.py"]
