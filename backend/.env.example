# === SUPABASE ===

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === MYSQL ===
# MySQL é o banco principal (conectado via SQLAlchemy/PyMySQL).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=catas_db

# === DATABASE (SQLAlchemy) ===
# Connection string for direct MySQL access (via SQLAlchemy)
# Formato: mysql+pymysql://user:password@host:port/database
# Exemplo: mysql+pymysql://root:root@localhost:3306/catas_db
DATABASE_URL=

# === AUTH ===~
# Google OAuth — necessário para integrações Gmail/Calendar/Drive/Docs
# Registre a redirect URI abaixo no Google Cloud Console → Credenciais → Web Client
#   http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === FIREBASE ===

FIREBASE_ADMIN_SDK_JSON_PATH=

# === IA ===

OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# MODELS

# Chat Padrão (Multimodal/Visão)
MODEL_TIER_BASIC=ai|ai-model|ai-api-url|env-key-ai-api-key
MODEL_TIER_PRO=ai|ai-model|ai-api-url|env-key-ai-api-key
MODEL_TIER_MAX=ai|ai-model|ai-api-url|env-key-ai-api-key

# Classifica se é conversa ou ação (recomendo um modelo rápido)
AGENT_INTENT_CLASSIFIER=ai|ai-model|ai-api-url|env-key-ai-api-key

# Extrai nomes, datas e emails (recomendo um modelo preciso)
AGENT_ENTITY_EXTRACTOR=ai|ai-model|ai-api-url|env-key-ai-api-key

# Interpreta a ideia do usuário
AGENT_INTERPRETER=ai|ai-model|ai-api-url|env-key-ai-api-key
# Decide se vai pra n8n ou Python
AGENT_CLASSIFIER=ai|ai-model|ai-api-url|env-key-ai-api-key
# Escolhe e adapta o fluxo n8n
AGENT_SELECTOR=ai|ai-model|ai-api-url|env-key-ai-api-key
# Escreve o código Python final
AGENT_DEVELOPER=ai|ai-model|ai-api-url|env-key-ai-api-key

# Transforma/extrai dados no Worker (módulo ai.transform_data)
AGENT_WORKER_TRANSFORM=ai|ai-model|ai-api-url|env-key-ai-api-key


# Exemplo de como usar com o Gemini no Interpreter (requer API Key correspondente):
# AGENT_INTERPRETER=gemini|gemini-2.5-flash|https://generativelanguage.googleapis.com/v1beta|GOOGLE_API_KEY





# === STRIPE ===

# TEST
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BASIC_PLAN_ID=
# PRO_PLAN_ID=
# MAX_PLAN_ID=

# LOCAL TEST
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BASIC_PLAN_ID=
PRO_PLAN_ID=
MAX_PLAN_ID=

# PRODUCTION
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# BASIC_PLAN_ID=
# PRO_PLAN_ID=
# MAX_PLAN_ID=

# === APP ===
APP_DEEP_LINK_SCHEME=catas

# === Criptografia Interna ===
ENCRYPTION_KEY=

# === Servidor ===
ENVIRONMENT=development|production

# === Demo ===
DEMO_ONBOARDING_ENABLED=true
DEMO_CLIENTES_SPREADSHEET_ID=  # ID da planilha "Clientes" no Google Sheets
DEMO_CLIENTES_FOLDER_ID=        # ID da pasta "Clientes" no Google Drive

# === Worker ===
WORKER_URL=http://catas_worker:8001
ENABLE_WORKER_DATA_LOGS=true